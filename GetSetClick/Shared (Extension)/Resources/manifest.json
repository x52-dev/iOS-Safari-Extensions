{
    "manifest_version": 3,
    "name": "GetSetClicks",
    "description": "Immersive Manga Reader Mode and Dynamic Media Engine for Safari.",
    "version": "1.0",

    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png"
    },

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "content_scripts": [{
        "js": [ "content.js" ],
        "matches": [ "<all_urls>" ],
        "run_at": "document_start"
    }],

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon-16.png",
            "32": "images/icon-32.png",
            "48": "images/icon-48.png",
            "96": "images/icon-96.png"
        }
    }
}
